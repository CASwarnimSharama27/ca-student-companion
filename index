async function buildAgentPlan(){
  const holder = document.getElementById('agentHolder');
  ui.agentError = "";
  ui.agentPlan = null;
  holder.innerHTML = `<div class="answer-box loading" style="margin-top:16px;">Reviewing your syllabus, streak and mock scores…</div>`;

  const subs = currentSubjects();
  const pending = subs.map(s=>({
    subject: s.name,
    percentDone: subjectProgress(s),
    pendingChapters: s.chapters.filter(c=>!c.done).map(c=>c.name)
  }));
  const recentMocks = state.mockTests.filter(m=>m.level===state.level).slice(-6).map(m=>({
    subject:m.subject, percent: Math.round((m.score/m.max)*100)
  }));

  const contextSummary = {
    level: LEVEL_LABEL[state.level],
    daysToExam: daysUntilExam(),
    overallProgressPercent: overallProgress(),
    currentStreakDays: computeStreak(),
    subjects: pending,
    recentMockScores: recentMocks,
    studentNotes: ui.agentContext || "(none given)"
  };

  const prompt = `You are an AI study-planning agent inside a CA (Chartered Accountancy, India) student's app. Here is the student's real current state as JSON:
${JSON.stringify(contextSummary, null, 2)}

Build a focused study plan for the next 7 days. Prioritize subjects with lower percentDone and lower recent mock scores. Respect the student's own notes if given. Use chapter names EXACTLY as they appear in "pendingChapters" above — do not invent or reword them, and do not include chapters that are not listed as pending.

Respond with ONLY valid JSON (no markdown fences, no commentary before or after), matching exactly this shape:
{"summary": "2-3 sentence plain-language summary of the plan and why", "tasks": [{"subject": "exact subject name", "chapter": "exact pending chapter name", "note": "one short actionable line"}]}
Include 5 to 8 tasks total.`;

  try{
    const response = await fetch("https://api.anthropic.com/v1/messages", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({
        model: "claude-sonnet-4-6",
        max_tokens: 1000,
        messages: [{ role:"user", content: prompt }]
      })
    });
    const data = await response.json();
    let text = (data.content||[]).map(b=>b.text||'').join('\n').trim();
    text = text.replace(/^```json/i,'').replace(/^```/,'').replace(/```$/,'').trim();
    const parsed = JSON.parse(text);
    ui.agentPlan = parsed;
  }catch(err){
    ui.agentError = "The agent couldn't build a plan just now — please try again in a moment.";
    console.error(err);
  }
  holder.innerHTML = renderAgentPlan();
  bindAgentTaskEvents();
}

