async function solveDoubt(){
  const q = document.getElementById('solverQuestion').value.trim();
  const subj = document.getElementById('solverSubject').value;
  const holder = document.getElementById('answerHolder');
  if(!q){ return; }
  holder.innerHTML = `<div class="answer-box loading">Thinking through it…</div>`;
  try{
    const prompt = `You are a patient, precise tutor for an Indian CA (Chartered Accountancy) student at the ${LEVEL_LABEL[state.level]} level${subj? ", studying the paper '"+subj+"'":""}. Answer the student's doubt clearly and step by step, using ICAI terminology and, where relevant, the applicable section/standard number. Keep the explanation focused and exam-oriented. Student's doubt: ${q}`;
    const response = await fetch("https://api.anthropic.com/v1/messages", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({
        model: "claude-sonnet-4-6",
        max_tokens: 1000,
        messages: [{ role:"user", content: prompt }]
      })
    });
    const data = await response.json();
    const text = (data.content||[]).map(b=>b.text||'').join('\n').trim();
    holder.innerHTML = `<div class="answer-box">${esc(text || "No answer returned — please try rephrasing your question.")}</div>`;
  }catch(err){
    holder.innerHTML = `<div class="answer-box">Something went wrong reaching the AI tutor. Please try again in a moment.</div>`;
    console.error(err);
  }
}

init();
})();
</script>
</body>
</html>
