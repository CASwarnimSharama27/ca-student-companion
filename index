<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>CA Student Companion</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Source+Serif+4:opsz,wght@8..60,400;8..60,600;8..60,700&family=IBM+Plex+Sans:wght@400;500;600&family=IBM+Plex+Mono:wght@500;600&display=swap" rel="stylesheet">
<style>
  :root{
    --paper:#F5EFDC;
    --paper-2:#EFE7CE;
    --ink:#20261F;
    --ink-soft:#4B5045;
    --navy:#1C2B45;
    --navy-2:#28395A;
    --forest:#2F4A3D;
    --forest-2:#3C6350;
    --brass:#A9791F;
    --brass-2:#C79433;
    --stamp:#9B3A2E;
    --stamp-2:#B54E40;
    --teal:#2E5C5A;
    --slate:#46566B;
    --rule: rgba(32,38,31,0.12);
    --card: #FBF7EA;
    --shadow: 0 2px 0 rgba(32,38,31,0.06);
  }
  *{box-sizing:border-box;}
  html,body{margin:0;padding:0;}
  body{
    background:var(--paper);
    color:var(--ink);
    font-family:'IBM Plex Sans', sans-serif;
    min-height:100vh;
  }
  h1,h2,h3,.serif{font-family:'Source Serif 4', serif;}
  .num, .mono{font-family:'IBM Plex Mono', monospace;}

  #app{
    display:flex;
    min-height:100vh;
    max-width:1180px;
    margin:0 auto;
    background:
      repeating-linear-gradient(
        to bottom,
        transparent 0px, transparent 27px, var(--rule) 28px
      ),
      var(--paper);
  }

  /* ---------- Left binder rail ---------- */
  .rail{
    width:190px;
    flex-shrink:0;
    padding:28px 0 28px 18px;
    display:flex;
    flex-direction:column;
    gap:6px;
  }
  .brand{
    padding:2px 14px 22px 4px;
  }
  .brand .mark{
    font-family:'Source Serif 4', serif;
    font-weight:700;
    font-size:20px;
    color:var(--navy);
    line-height:1.15;
  }
  .brand .sub{
    font-size:11px;
    color:var(--ink-soft);
    margin-top:4px;
    letter-spacing:.02em;
  }
  .tab{
    position:relative;
    text-align:left;
    background:var(--paper-2);
    border:1px solid var(--rule);
    border-right:none;
    color:var(--ink-soft);
    font-family:'IBM Plex Sans', sans-serif;
    font-size:13.5px;
    font-weight:500;
    padding:11px 14px;
    border-radius:8px 0 0 8px;
    cursor:pointer;
    transition:transform .12s ease, background .12s ease, color .12s ease;
  }
  .tab:hover{ transform: translateX(-2px); }
  .tab.active{
    background:var(--card);
    color:var(--navy);
    font-weight:600;
    border-color:var(--rule);
    box-shadow: -1px 0 0 var(--card), var(--shadow);
  }
  .tab.active::after{
    content:"";
    position:absolute;
    right:-1px; top:0; bottom:0; width:3px;
    background:var(--brass);
  }
  .tab .icon{ margin-right:9px; opacity:.75; }

  /* ---------- Main ---------- */
  main{
    flex:1;
    background:var(--card);
    border-left:1px solid var(--rule);
    min-width:0;
    padding:0;
  }
  .letterhead{
    padding:26px 34px 16px 34px;
    border-bottom:2px solid var(--navy);
    display:flex;
    align-items:baseline;
    justify-content:space-between;
    flex-wrap:wrap;
    gap:10px;
  }
  .letterhead h1{
    font-size:22px;
    margin:0;
    color:var(--navy);
    font-weight:600;
  }
  .level-switch{
    display:flex;
    gap:2px;
    background:var(--paper-2);
    border:1px solid var(--rule);
    border-radius:7px;
    padding:2px;
  }
  .level-switch button{
    border:none;
    background:transparent;
    padding:6px 12px;
    font-family:'IBM Plex Sans';
    font-size:12.5px;
    font-weight:500;
    color:var(--ink-soft);
    border-radius:5px;
    cursor:pointer;
  }
  .level-switch button.active{
    background:var(--navy);
    color:var(--paper);
  }
  .content{ padding:26px 34px 60px 34px; }

  /* ---------- Dashboard ---------- */
  .dash-grid{
    display:grid;
    grid-template-columns: 220px 1fr 1fr;
    gap:20px;
    margin-bottom:26px;
  }
  @media (max-width: 820px){ .dash-grid{ grid-template-columns:1fr; } #app{flex-direction:column;} .rail{flex-direction:row; width:auto; padding:14px 14px 0 14px; overflow-x:auto;} .tab{border-radius:8px 8px 0 0; border:1px solid var(--rule); border-bottom:none;} .tab.active::after{right:0; left:0; top:-1px; bottom:auto; height:3px; width:auto;} .brand{display:none;} }

  .stamp-wrap{
    display:flex; align-items:center; justify-content:center;
  }
  .stamp{
    width:172px; height:172px;
    border-radius:50%;
    border:3px double var(--stamp);
    color:var(--stamp);
    display:flex; flex-direction:column; align-items:center; justify-content:center;
    transform:rotate(-6deg);
    text-align:center;
    position:relative;
  }
  .stamp .n{ font-family:'IBM Plex Mono'; font-size:46px; font-weight:600; line-height:1; }
  .stamp .l1{ font-size:10.5px; letter-spacing:.14em; margin-top:4px; }
  .stamp .l2{ font-size:9px; letter-spacing:.1em; opacity:.75; margin-top:1px; }

  .panel{
    background:var(--paper);
    border:1px solid var(--rule);
    border-radius:10px;
    padding:16px 18px;
  }
  .panel h3{
    margin:0 0 12px 0;
    font-size:13px;
    color:var(--ink-soft);
    font-weight:600;
    letter-spacing:.01em;
  }
  .countdown-row{ display:flex; align-items:baseline; gap:10px; }
  .countdown-row .n{ font-family:'IBM Plex Mono'; font-size:38px; color:var(--navy); font-weight:600; }
  .countdown-row .l{ font-size:12.5px; color:var(--ink-soft); }
  .exam-date-input{ margin-top:10px; display:flex; align-items:center; gap:8px; }
  .exam-date-input label{ font-size:11.5px; color:var(--ink-soft); }
  input[type=date], input[type=number], input[type=text], textarea, select{
    font-family:'IBM Plex Sans';
    border:1px solid var(--rule);
    background:#fff;
    border-radius:6px;
    padding:6px 8px;
    font-size:13px;
    color:var(--ink);
  }
  .hours-log{ display:flex; gap:8px; align-items:center; flex-wrap:wrap; margin-top:6px; }
  .btn{
    font-family:'IBM Plex Sans';
    font-weight:600;
    font-size:12.5px;
    padding:7px 13px;
    border-radius:6px;
    border:1px solid var(--navy);
    background:var(--navy);
    color:var(--paper);
    cursor:pointer;
  }
  .btn.ghost{ background:transparent; color:var(--navy); }
  .btn.small{ padding:4px 9px; font-size:11.5px; }
  .btn.stamp-btn{ border-color:var(--stamp); background:var(--stamp); }
  .btn.brass-btn{ border-color:var(--brass); background:var(--brass); color:#2a1e05; }

  .week-strip{ display:flex; gap:6px; margin-top:12px; }
  .week-day{
    flex:1; text-align:center; padding:7px 0; border-radius:6px;
    font-size:11px; color:var(--ink-soft); background:var(--paper-2); border:1px solid var(--rule);
  }
  .week-day.done{ background:var(--forest); color:#fff; border-color:var(--forest); }
  .week-day .d{ font-weight:600; font-size:12px; }

  .progress-list{ display:flex; flex-direction:column; gap:12px; }
  .prog-item{ display:flex; flex-direction:column; gap:4px; }
  .prog-top{ display:flex; justify-content:space-between; font-size:12.5px; }
  .prog-top .name{ color:var(--ink); font-weight:500; }
  .prog-top .pct{ font-family:'IBM Plex Mono'; color:var(--ink-soft); }
  .bar{ height:7px; border-radius:4px; background:var(--paper-2); overflow:hidden; border:1px solid var(--rule); }
  .bar > div{ height:100%; }

  /* ---------- Syllabus ---------- */
  .subject-card{
    border:1px solid var(--rule);
    border-left:5px solid var(--accent, var(--navy));
    border-radius:8px;
    background:var(--paper);
    margin-bottom:14px;
    overflow:hidden;
  }
  .subject-head{
    display:flex; align-items:center; justify-content:space-between;
    padding:13px 16px; cursor:pointer;
  }
  .subject-head .name{ font-weight:600; font-size:14.5px; }
  .subject-head .meta{ font-size:12px; color:var(--ink-soft); font-family:'IBM Plex Mono'; }
  .subject-body{ padding:0 16px 16px 16px; display:none; }
  .subject-body.open{ display:block; }
  .chapter-row{
    display:flex; align-items:center; gap:10px;
    padding:7px 0; border-top:1px dashed var(--rule);
    font-size:13px;
  }
  .chapter-row:first-child{ border-top:none; }
  .chapter-row .cname{ flex:1; }
  .chapter-row .cname.done{ text-decoration:line-through; color:var(--ink-soft); }
  .chip{
    font-size:10.5px; padding:2px 7px; border-radius:10px; border:1px solid var(--rule);
    color:var(--ink-soft); cursor:pointer; user-select:none; white-space:nowrap;
  }
  .chip.on{ background:var(--brass); color:#2a1e05; border-color:var(--brass); }
  .add-chapter-row{ display:flex; gap:8px; margin-top:10px; }
  .add-chapter-row input{ flex:1; }
  .notes-area{ margin-top:12px; }
  .notes-area textarea{ width:100%; min-height:70px; resize:vertical; font-size:13px; }
  .resources{ margin-top:10px; font-size:12px; color:var(--ink-soft); }
  .resources b{ color:var(--ink); }

  /* ---------- Mock tests ---------- */
  table{ width:100%; border-collapse:collapse; font-size:13px; }
  th{ text-align:left; font-size:11px; text-transform:none; color:var(--ink-soft); padding:6px 8px; border-bottom:2px solid var(--navy); }
  td{ padding:7px 8px; border-bottom:1px solid var(--rule); }
  .score-good{ color:var(--forest); font-weight:600; }
  .score-bad{ color:var(--stamp); font-weight:600; }
  .add-mock-form{ display:flex; gap:8px; flex-wrap:wrap; align-items:center; margin-bottom:16px; background:var(--paper); border:1px solid var(--rule); padding:12px 14px; border-radius:8px; }
  .add-mock-form input, .add-mock-form select{ width:auto; }

  /* ---------- Doubt solver ---------- */
  .solver{ max-width:720px; }
  .solver textarea{ width:100%; min-height:110px; font-size:14px; }
  .answer-box{
    margin-top:18px; background:var(--paper); border:1px solid var(--rule); border-left:4px solid var(--forest);
    border-radius:8px; padding:16px 18px; font-size:14px; line-height:1.6; white-space:pre-wrap;
  }
  .answer-box.loading{ color:var(--ink-soft); font-style:italic; }
  .subject-select-row{ display:flex; gap:10px; align-items:center; margin-bottom:10px; flex-wrap:wrap; }

  .empty{ font-size:13px; color:var(--ink-soft); padding:20px 0; }
  .small-note{ font-size:11.5px; color:var(--ink-soft); margin-top:6px; }
  .flex-between{ display:flex; justify-content:space-between; align-items:center; }

  /* ---------- Auth / profile picker ---------- */
  .auth-wrap{
    min-height:100vh; display:flex; align-items:center; justify-content:center;
    padding:30px; width:100%;
  }
  .auth-card{
    width:100%; max-width:420px;
    background:var(--card);
    border:1px solid var(--rule);
    border-top:5px solid var(--navy);
    border-radius:10px;
    padding:30px 30px 26px 30px;
  }
  .auth-card h1{ margin:0 0 4px 0; color:var(--navy); font-size:23px; }
  .auth-card .tag{ font-size:12.5px; color:var(--ink-soft); margin-bottom:22px; }
  .profile-list{ display:flex; flex-direction:column; gap:8px; margin-bottom:18px; }
  .profile-btn{
    text-align:left; padding:11px 14px; border:1px solid var(--rule); border-radius:8px;
    background:var(--paper); cursor:pointer; font-family:'IBM Plex Sans'; font-size:14px; color:var(--ink);
    display:flex; align-items:center; justify-content:space-between;
  }
  .profile-btn:hover{ border-color:var(--navy); }
  .profile-btn .seal{
    width:26px; height:26px; border-radius:50%; border:2px solid var(--brass); color:var(--brass);
    display:flex; align-items:center; justify-content:center; font-size:12px; font-weight:600; font-family:'IBM Plex Mono';
  }
  .auth-divider{ font-size:11px; color:var(--ink-soft); text-align:center; margin:16px 0 12px 0; }
  .new-profile-row{ display:flex; gap:8px; }
  .new-profile-row input{ flex:1; }
  .auth-note{ font-size:11px; color:var(--ink-soft); margin-top:16px; line-height:1.5; }
  .signed-in-as{ font-size:11px; color:var(--ink-soft); margin-top:10px; }
  .signed-in-as button{
    display:block; margin-top:3px; background:none; border:none; color:var(--navy);
    font-size:11px; text-decoration:underline; cursor:pointer; padding:0; font-family:'IBM Plex Sans';
  }
  .agent-plan{ margin-top:18px; }
  .agent-summary{ background:var(--paper); border:1px solid var(--rule); border-left:4px solid var(--brass); border-radius:8px; padding:14px 16px; font-size:13.5px; line-height:1.55; margin-bottom:14px; }
  .agent-task{ display:flex; align-items:flex-start; gap:10px; padding:10px 0; border-top:1px dashed var(--rule); }
  .agent-task:first-child{ border-top:none; }
  .agent-task .body{ flex:1; }
  .agent-task .subj{ font-size:11px; color:var(--ink-soft); font-family:'IBM Plex Mono'; }
  .agent-task .chap{ font-size:13.5px; font-weight:500; margin-top:1px; }
  .agent-task .note{ font-size:12.5px; color:var(--ink-soft); margin-top:2px; }
  .agent-task .marked{ font-size:11px; color:var(--forest); font-weight:600; }
</style>
</head>
<body>
<div id="app"></div>

<script>
(function(){

/* ============ Default syllabus data ============ */
const ACCENTS = ["#1C2B45","#2F4A3D","#A9791F","#9B3A2E","#2E5C5A","#46566B"];

function mk(name, chapters){ return { name, chapters: chapters.map(c=>({name:c, done:false, revised:false})) }; }

const DEFAULT_SUBJECTS = {
  foundation: [
    mk("Accounting", ["Theoretical Framework","Accounting Process","Bank Reconciliation Statement","Inventories","Depreciation & Capital/Revenue Items","Bills of Exchange & Promissory Notes","Financial Statements — Sole Proprietorship","Partnership Accounts"]),
    mk("Business Laws", ["Indian Regulatory Framework","Indian Contract Act, 1872","Sale of Goods Act, 1930","Indian Partnership Act, 1932","The LLP Act, 2008","Companies Act, 2013 — Basics"]),
    mk("Quantitative Aptitude", ["Ratio, Proportion & Indices","Equations & Linear Inequalities","Time Value of Money","Permutations & Combinations","Sequence & Series","Sets, Relations & Functions","Statistical Description of Data","Probability"]),
    mk("Business Economics", ["Nature & Scope of Business Economics","Theory of Demand & Supply","Theory of Production & Cost","Price Determination in Different Markets","Business Cycles","Indian Economy — An Overview"])
  ],
  intermediate: [
    mk("Advanced Accounting", ["Introduction to Accounting Standards","Financial Statements of Companies","Buy-back & Alteration of Share Capital","Amalgamation of Companies","Consolidated Financial Statements","Accounting for Branches","Departmental Accounts"]),
    mk("Corporate & Other Laws", ["Companies Act — Share Capital & Debentures","Appointment & Qualification of Directors","Meetings of Board & Shareholders","Declaration & Payment of Dividend","Accounts & Audit","The General Clauses Act, 1897","Interpretation of Statutes"]),
    mk("Taxation (Income-tax + GST)", ["Basic Concepts of Income-tax","Residence & Scope of Total Income","Heads of Income","Computation of Total Income & Tax Liability","GST — Supply & Levy","Input Tax Credit","Registration & Returns under GST"]),
    mk("Cost & Management Accounting", ["Introduction to Cost & Management Accounting","Material Cost","Employee Cost & Direct Expenses","Overheads — Absorption Costing","Cost Sheet & Cost Records","Activity Based Costing","Standard Costing","Marginal Costing","Budget & Budgetary Control"]),
    mk("Auditing & Ethics", ["Nature, Objective & Scope of Audit","Audit Strategy, Planning & Programme","Audit Documentation & Audit Evidence","Risk Assessment & Internal Control","Audit of Items of Financial Statements","Company Audit","Audit Report","Professional Ethics"]),
    mk("Financial & Strategic Management", ["Scope & Objectives of Financial Management","Time Value of Money","Financial & Ratio Analysis","Cost of Capital","Capital Structure Decisions","Capital Budgeting","Working Capital Management","Introduction to Strategic Management","Business Strategy & SWOT"])
  ],
  final: [
    mk("Financial Reporting", ["Framework for Ind AS","Ind AS on Assets","Ind AS on Liabilities & Provisions","Business Combinations & Corporate Restructuring","Consolidated Financial Statements","Ind AS on Financial Instruments","Analysis of Financial Statements"]),
    mk("Advanced Financial Management", ["Capital Budgeting Decisions","Security Analysis & Valuation","Portfolio Management","Derivatives & Risk Management","International Financial Management","Mergers, Acquisitions & Corporate Restructuring","Startup Finance"]),
    mk("Advanced Auditing & Professional Ethics", ["Quality Control & Engagement Standards","Audit of Complex Business Transactions","Group Audits","Audit of Banks & Insurance Companies","Due Diligence, Investigation & Forensic Audit","Professional Ethics & Liabilities of Auditors"]),
    mk("Direct Tax Laws & International Taxation", ["Basis of Charge & Residential Status — Advanced","Heads of Income — Advanced Provisions","Assessment of Various Entities","Transfer Pricing","Double Taxation Relief","International Tax — BEPS & Treaties"]),
    mk("Indirect Tax Laws", ["Supply & Levy under GST — Advanced","Input Tax Credit — Advanced","Returns, Assessment & Audit under GST","Demand, Recovery & Appeals","Customs Act — Basics & Valuation","Foreign Trade Policy"]),
    mk("Integrated Business Solutions", ["Case Studies — Financial Reporting","Case Studies — Audit & Assurance","Case Studies — Direct & Indirect Tax","Case Studies — Costing & FM","Case Studies — Law & Strategic Management"])
  ]
};

const RESOURCES = {
  "Accounting":["ICAI Study Material","D.S. Rawat — Accounting"],
  "Business Laws":["ICAI Study Material","MC Kuchhal — Business Law"],
  "Quantitative Aptitude":["ICAI Study Material","Padhuka QA Guide"],
  "Business Economics":["ICAI Study Material","Mankiw — Principles of Economics (reference)"],
  "Advanced Accounting":["ICAI Study Material","D.S. Rawat — Advanced Accounting"],
  "Corporate & Other Laws":["ICAI Study Material","Munish Bhandari — Corporate Law"],
  "Taxation (Income-tax + GST)":["ICAI Study Material","Vinod K. Singhania — Direct Taxes"],
  "Cost & Management Accounting":["ICAI Study Material","Ravi M Kishore — Cost Accounting"],
  "Auditing & Ethics":["ICAI Study Material","Surbhi Bansal — Auditing"],
  "Financial & Strategic Management":["ICAI Study Material","Sanjay Saraf — FM & SM"],
  "Financial Reporting":["ICAI Study Material","D.S. Rawat — Ind AS"],
  "Advanced Financial Management":["ICAI Study Material","Sanjay Saraf — AFM"],
  "Advanced Auditing & Professional Ethics":["ICAI Study Material","Surbhi Bansal — Advanced Auditing"],
  "Direct Tax Laws & International Taxation":["ICAI Study Material","Vinod K. Singhania — DT & International Tax"],
  "Indirect Tax Laws":["ICAI Study Material","V.S. Datey — Indirect Tax Law"],
  "Integrated Business Solutions":["ICAI Study Material & Past Case Studies"]
};

const LEVEL_LABEL = { foundation:"Foundation", intermediate:"Intermediate", final:"Final" };

/* ============ State ============ */
function freshState(){
  return {
    level: "intermediate",
    subjects: JSON.parse(JSON.stringify(DEFAULT_SUBJECTS)),
    examDates: { foundation:"", intermediate:"", final:"" },
    studyLog: [],       // {date:'YYYY-MM-DD', hours:Number}
    mockTests: [],       // {id, date, level, subject, score, max}
    openSubject: null
  };
}
let state = freshState();
let ui = { tab: "dashboard", newChapterText: {}, agentPlan:null, agentContext:"", agentError:"" };
let saveTimer = null;
let screen = "auth";           // "auth" | "app"
let activeProfile = null;      // { slug, displayName }
let profilesIndex = [];        // [{slug, displayName}]

const INDEX_KEY = "ca-companion:profiles-index";
const ACTIVE_KEY = "ca-companion:active-profile";
function profileKey(slug){ return `ca-companion:profile:${slug}`; }

function slugify(name){
  return name.trim().toLowerCase().replace(/[^a-z0-9]+/g,'-').replace(/(^-|-$)/g,'') || ('student-'+Date.now());
}

async function init(){
  try{
    const idxRes = await window.storage.get(INDEX_KEY, false);
    if(idxRes && idxRes.value) profilesIndex = JSON.parse(idxRes.value);
  }catch(e){ profilesIndex = []; }

  try{
    const activeRes = await window.storage.get(ACTIVE_KEY, false);
    if(activeRes && activeRes.value){
      const { slug } = JSON.parse(activeRes.value);
      const rec = await window.storage.get(profileKey(slug), false);
      if(rec && rec.value){
        const parsed = JSON.parse(rec.value);
        activeProfile = { slug, displayName: parsed.displayName };
        state = Object.assign(freshState(), parsed.state || {});
        screen = "app";
      }
    }
  }catch(e){ /* no active profile saved yet */ }

  render();
}

async function saveProfilesIndex(){
  try{ await window.storage.set(INDEX_KEY, JSON.stringify(profilesIndex), false); }
  catch(e){ console.error("index save failed", e); }
}

async function loginProfile(slug){
  try{
    const rec = await window.storage.get(profileKey(slug), false);
    if(!rec || !rec.value) return;
    const parsed = JSON.parse(rec.value);
    activeProfile = { slug, displayName: parsed.displayName };
    state = Object.assign(freshState(), parsed.state || {});
    screen = "app";
    await window.storage.set(ACTIVE_KEY, JSON.stringify({slug}), false);
    render();
  }catch(e){ console.error("login failed", e); }
}

async function createProfile(displayName){
  const name = displayName.trim();
  if(!name) return;
  const slug = slugify(name);
  const existing = profilesIndex.find(p=>p.slug===slug);
  if(existing){ await loginProfile(slug); return; }
  activeProfile = { slug, displayName: name };
  state = freshState();
  profilesIndex.push({ slug, displayName: name });
  await saveProfilesIndex();
  await window.storage.set(profileKey(slug), JSON.stringify({ displayName:name, state }), false);
  await window.storage.set(ACTIVE_KEY, JSON.stringify({slug}), false);
  screen = "app";
  render();
}

async function switchProfile(){
  await persistNow();
  try{ await window.storage.delete(ACTIVE_KEY, false); }catch(e){ /* fine if missing */ }
  activeProfile = null;
  state = freshState();
  screen = "auth";
  render();
}

function queueSave(){
  clearTimeout(saveTimer);
  saveTimer = setTimeout(persistNow, 350);
}

async function persistNow(){
  if(!activeProfile) return;
  try{
    await window.storage.set(profileKey(activeProfile.slug), JSON.stringify({ displayName: activeProfile.displayName, state }), false);
  }catch(e){ console.error("save failed", e); }
}

function todayStr(){ return new Date().toISOString().slice(0,10); }

function dateNDaysAgo(n){
  const d = new Date();
  d.setDate(d.getDate()-n);
  return d.toISOString().slice(0,10);
}

/* ============ Derived data ============ */
function currentSubjects(){ return state.subjects[state.level] || []; }

function subjectProgress(sub){
  const total = sub.chapters.length || 1;
  const done = sub.chapters.filter(c=>c.done).length;
  return Math.round((done/total)*100);
}

function overallProgress(){
  const subs = currentSubjects();
  const totalCh = subs.reduce((a,s)=>a+s.chapters.length,0) || 1;
  const doneCh = subs.reduce((a,s)=>a+s.chapters.filter(c=>c.done).length,0);
  return Math.round((doneCh/totalCh)*100);
}

function computeStreak(){
  const byDate = {};
  state.studyLog.forEach(l=>{ byDate[l.date] = (byDate[l.date]||0) + Number(l.hours||0); });
  let streak = 0;
  let cursor = new Date();
  // if no hours logged today yet, still count backward from yesterday
  let d = new Date(cursor);
  while(true){
    const key = d.toISOString().slice(0,10);
    if(byDate[key] && byDate[key] > 0){
      streak++;
      d.setDate(d.getDate()-1);
    } else {
      if(key === todayStr()){ d.setDate(d.getDate()-1); continue; } // today not logged yet, skip and check yesterday
      break;
    }
  }
  return streak;
}

function hoursToday(){
  const t = todayStr();
  return state.studyLog.filter(l=>l.date===t).reduce((a,l)=>a+Number(l.hours||0),0);
}

function last7Days(){
  const byDate = {};
  state.studyLog.forEach(l=>{ byDate[l.date] = (byDate[l.date]||0) + Number(l.hours||0); });
  const arr = [];
  for(let i=6;i>=0;i--){
    const dt = new Date(); dt.setDate(dt.getDate()-i);
    const key = dt.toISOString().slice(0,10);
    arr.push({ label: dt.toLocaleDateString(undefined,{weekday:'narrow'}), date:key, hours: byDate[key]||0 });
  }
  return arr;
}

function daysUntilExam(){
  const ds = state.examDates[state.level];
  if(!ds) return null;
  const today = new Date(); today.setHours(0,0,0,0);
  const target = new Date(ds); target.setHours(0,0,0,0);
  const diff = Math.round((target-today)/86400000);
  return diff;
}

